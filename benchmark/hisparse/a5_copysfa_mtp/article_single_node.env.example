# Source this file in each manual test terminal; replace MODEL_PATH first.
# Model target: article GLM-5.2 W4A4_MXFP4 checkpoint with C8 KV.
# Initial bring-up: one node, TP8/EP8, DP1/PP1/CP1. Article uses DP4/TP2.
export FRAMEWORK_ROOT="${FRAMEWORK_ROOT:-/mnt/share/y00970600/personal/sglang}"
export KERNEL_ROOT="${KERNEL_ROOT:-/mnt/share/y00970600/personal/sgl-kernel-npu}"
export PYTHON_BIN="${PYTHON_BIN:-$(command -v python3)}"
export RUN_ROOT="${RUN_ROOT:-/mnt/share/y00970600/a5-joint-runs}"
export MODEL_PATH="${MODEL_PATH:-/path/to/GLM-5.2-W4A4-MXFP4}"
export QUANTIZATION="${QUANTIZATION:-modelslim}"
export ASCEND_RT_VISIBLE_DEVICES="${ASCEND_RT_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
export TP_SIZE=8 EP_SIZE=8 PORT="${PORT:-30000}"
export SPARSE_CACHE_SIZE=12288 MAX_RUNNING_REQUESTS=16 CONCURRENCY=16
export INPUT_TOKENS=40000 OUTPUT_TOKENS=1024 CONTEXT_LENGTH=45056
export CHUNKED_PREFILL_SIZE=4096
export MTP="${MTP:-1}" GRAPH="${GRAPH:-1}"
unset SGLANG_NPU_A5_LIM_LIBRARY
