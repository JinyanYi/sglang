# Same SGLang/model/runtime baseline for article Table 7, 40K, per-DP BS7.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/article_single_node.env.example"
export KV_OFFLOAD=0 MTP=1 GRAPH=1
export PER_DP_BATCH_SIZE="${BASELINE_PER_DP_BATCH_SIZE:-7}"
[[ "$PER_DP_BATCH_SIZE" =~ ^[1-9][0-9]*$ ]] || {
  echo "BASELINE_PER_DP_BATCH_SIZE must be positive" >&2; return 2;
}
# TP2 draft decode needs an even graph bucket. Keep actual concurrency seven.
export GRAPH_BATCH_SIZE="$(((PER_DP_BATCH_SIZE + 1) / 2 * 2))"
export MAX_RUNNING_REQUESTS="$((ATTN_DP_SIZE * PER_DP_BATCH_SIZE))"
export CONCURRENCY="$MAX_RUNNING_REQUESTS"
export NUM_PROMPTS="$CONCURRENCY"
export MEM_FRACTION_STATIC="${MEM_FRACTION_STATIC:-0.80}"
export SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-a5-c8-native-mtp}"
# Preserve the previous offload run's DeepEP capacity to avoid a second variable.
export SGLANG_DEEPEP_NUM_MAX_DISPATCH_TOKENS_PER_RANK=64
if [[ -n "${BASELINE_MAX_TOTAL_TOKENS:-}" ]]; then
  export MAX_TOTAL_TOKENS="$BASELINE_MAX_TOTAL_TOKENS"
else
  unset MAX_TOTAL_TOKENS
fi
unset SGLANG_DISABLE_DRAFT_EXTEND_CUDA_GRAPH SGLANG_NPU_QUANT_LI_DEBUG_DIR
